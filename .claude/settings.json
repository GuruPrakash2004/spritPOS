{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run dev:*)",
      "Bash(npx eslint:*)",
      "Bash(.venv/bin/uvicorn:*)",
      "Bash(.venv/bin/pip install:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(curl -s http://localhost:8001/:*)",
      "Bash(curl -s http://localhost:5173/:*)"
    ],
    "deny": [
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/dist/**)",
      "Read(./backend/.venv/**)"
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npm run preview)"
    ],
    "deny": [
      "Read(./MAIN_Root/**/*.ini)",
      "Read(./MAIN_Root/**/*.INI)",
      "Read(./MAIN_Root/**/*.inibak)",
      "Read(./MAIN_Root/**/*.config)"
    ]
  }
}

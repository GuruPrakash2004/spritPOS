{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npm run preview)"
    ],
    "deny": [
      "Read(./MAIN_Root/**/*.ini)",
      "Read(./MAIN_Root/**/*.INI)",
      "Read(./MAIN_Root/**/*.inibak)",
      "Read(./MAIN_Root/**/*.config)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-loc.sh",
            "timeout": 30,
            "statusMessage": "Checking file sizes (500-line limit)"
          }
        ]
      }
    ]
  }
}

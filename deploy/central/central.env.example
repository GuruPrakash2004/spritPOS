# Settings of the hosted central site. Copy to central.env (never committed) and fill in.

# The address people open, without https:// (its DNS must point at this server).
CENTRAL_DOMAIN=central.example.com

# The central SQL Server and database (create the database and a SQL login for it first; see README.md).
# With `--profile db` the server is the `sqlserver` service: CENTRAL_DB_HOST=sqlserver.
CENTRAL_DB_HOST=
CENTRAL_DB_PORT=1433
CENTRAL_DB_NAME=vLQMSCentral
CENTRAL_DB_USER=
CENTRAL_DB_PASSWORD=

# Signs the owners' sign-in tokens: a long random value, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
CENTRAL_JWT_SECRET=

# Only with `--profile db`: the sa password of the bundled SQL Server (8+ characters, mixed).
MSSQL_SA_PASSWORD=

Public Class clsReg
    Dim clKey As New Collection
    Dim clRegNo As New Collection
    Public Function getKey(argRegNo As String) As String
        Dim i As Integer
        Call initkeys()
        Call initregNos()
        getKey = "-"
        For i = 1 To clRegNo.Count - 1
            If argRegNo = clRegNo.Item(i).ToString Then
                getKey = clKey.Item(i)
                Exit For
            End If
        Next
    End Function

    Public Function validKey(argRegNo As String, argKeyNo As String) As Boolean
        Dim i As Integer
        validKey = False
        Call initkeys()
        Call initregNos()
        For i = 1 To clRegNo.Count - 1
            If argRegNo = clRegNo.Item(i).ToString Then
                If argKeyNo = clKey.Item(i) Then
                    validKey = True
                    Exit For
                End If
            End If
        Next
    End Function
    Public Function getRegNo(argNo As Integer) As String
        getRegNo = ""
        Call initkeys()
        Call initregNos()
        Try
            getRegNo = clRegNo.Item(argNo).ToString
        Catch ex As Exception
        End Try
    End Function


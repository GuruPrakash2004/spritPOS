# Copy to frontend/.env (gitignored). Only VITE_* values reach the browser; never put passwords or keys that are not meant for the browser here.
# The backend's address (the FastAPI server). The browser calls it directly; the backend allows every origin.
# Leave it empty to call /api/... on the page's own address (Vite's dev proxy, or the backend serving the built frontend).
VITE_API_URL=http://localhost:8001
# The hosted central site's backend (central.html only; the shop app doesn't use it).
# VITE_CENTRAL_API_URL=http://localhost:8002


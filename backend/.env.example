# ==============================================================================
# Softvent vLQMS SaaS - Backend Environment Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
# ==============================================================================

# ─── Microsoft SQL Server Database Settings ──────────────────────────────────
# Server IP / Hostname of the SQL Server machine
DB_HOST=your_sql_server_host

# Database Port (Default MSSQL is 1433; named instances use their own port)
DB_PORT=1433

# Database Name
DB_NAME=vLQMSLHOUSE

# Database Credentials
DB_USER=your_database_user
DB_PASSWORD=your_database_password_here

# Optional: Specific SQL Server ODBC Driver override
# DB_DRIVER=ODBC Driver 18 for SQL Server

# ─── SQL Server write-back (app/writeback.py, migrations/) ─────────────────────
# Off by default. Bills and stock changes made in the web app are always queued as PENDING in the local
# SQLite outbox; when this is on they are copied into separate Web_* tables (never the legacy tables),
# including everything queued while it was off. Create the tables first: .venv/bin/python tools/migrate.py up
# Use a dedicated web login in DB_USER (migrations/000_web_login.template.sql), not sa.
DB_WRITE_ENABLED=false
# Optional: a setup login used only by tools/migrate.py (needs CREATE TABLE); the app never uses it.
# MIGRATE_DB_USER=your_setup_login
# MIGRATE_DB_PASSWORD=your_setup_password

# ─── Email (Customised Reports → Email) ──────────────────────────────────────
# Without SMTP_HOST the Email button says email isn't set up.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=g15772435@gmail.com
SMTP_PASSWORD=rgapkkyhwygq
SMTP_FROM=guruprakash832636@gmail.com

# ─── Security & JWT Authentication ───────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── Default Application Credentials (Web UI) ────────────────────────────────
DEFAULT_ADMIN_USER=ADMIN
DEFAULT_ADMIN_PASSWORD=admin

# ─── Server & Environment Settings ───────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

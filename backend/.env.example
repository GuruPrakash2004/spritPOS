# ==============================================================================
# Softvent vLQMS SaaS - Backend Environment Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
# ==============================================================================

# ─── Microsoft SQL Server (the shis op's own database) ───────────────────────────
# Normally left out: the sign-in page's one-time Database setup writes these keys (and only these).
# DB_HOST: localhost, or localhost\SQLEXPRESS for a named instance. DB_PORT: blank for a named instance.
# DB_AUTH: always sql (DB_USER + password); Windows login is not supported.
# DB_PASSWORD_ENC: the password sealed with backend/data/secret.key (written by the setup).
# A hand-written plain DB_PASSWORD also works for development; never commit a real one.
# DB_HOST=localhost\SQLEXPRESS
# DB_PORT=
# DB_NAME=your_vlqms_database
# DB_AUTH=sql
# DB_USER=your_database_user
# DB_PASSWORD_ENC=

# Optional: Specific SQL Server ODBC Driver override
# DB_DRIVER=ODBC Driver 18 for SQL Server
# Optional: force a Python driver. pyodbc (needs the Microsoft ODBC driver; best on Windows) or pymssql (nothing to
# install; SQL logins only). Empty tries pyodbc, then pymssql. Restart the backend after changing it.
# DB_ENGINE=pyodbc

# ─── Email (Customised Reports → Email) ──────────────────────────────────────
# Without SMTP_HOST the Email button says email isn't set up.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_from_address

# ─── Security & JWT Authentication ───────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── Default Application Credentials (Web UI) ────────────────────────────────
DEFAULT_ADMIN_USER=ADMIN
DEFAULT_ADMIN_PASSWORD=admin

# ─── Server & Environment Settings ───────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
# Cross-origin requests are allowed from anywhere (the frontend's VITE_API_URL points at this server); nothing to set.

# ─── Shop opening hours (Dashboard Store Open / Closed, app/shop_hours.py) ─────
# A Google Maps API key with "Places API (New)" enabled (Google Cloud console). The shop is found by the company
# name + address in Company Master. Leave blank to show no Open / Closed. Never commit the real key.
GOOGLE_MAPS_API_KEY=
SHOP_HOURS_CACHE_HOURS=6

# ─── Web Sync to the central site (Utilities → Web Sync, app/websync.py) ─────
# Leave blank to keep Web Sync off. The key comes from `.venv/bin/python tools/central.py add-client <CODE> "<Name>"`
# on the central server; it shown once. Never commit the real key.
WEB_SYNC_URL=
WEB_SYNC_KEY=
WEB_SYNC_MINUTES=10

# ─── Printing the desktop's Crystal .rpt formats (app/rpt_bridge.py, tools/rptbridge/) ─────────
# The Crystal Reports bridge is a small Windows program on the shop PC that runs the .rpt files exactly as the desktop
# does. Leave blank and printing says it isn't set up. The key must equal the one the bridge was started with.
RPT_BRIDGE_URL=
RPT_BRIDGE_KEY=
# Where the .rpt files are (the desktop's Reports -> RptFilePath). Default: backend/Rpts
RPT_FOLDER=
# Reports read the desktop's own tables (the web app saves its bills there too). Leave empty.
RPT_TABLE_PREFIX=
